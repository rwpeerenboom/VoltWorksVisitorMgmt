        <collection>x_snc_voltworksr_0_visit_request</collection>
        <condition/>
        <description>Auto-flags visit requests from external visitors (plant_visitor role) and routes them for EHS approval.</description>
        <execute_function>false</execute_function>
        <filter_condition/>
        <is_rest>false</is_rest>
        <message/>
        <name>Flag External Visitor Request</name>
        <order>40</order>
        <priority>100</priority>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[
(function executeRule(current, previous) {
  var isExternalVisitor = gs.hasRole("x_snc_voltworksr_0.plant_visitor");
  var isInternalEmployee = gs.hasRole("x_snc_voltworksr_0.plant_team_member");

  if (isExternalVisitor && !isInternalEmployee) {
    current.external_request = true;

    // Force external requests into pending EHS approval for extra scrutiny
    if (current.state == "requested") {
      current.state = "pending_ehs_approval";
    }

    gs.info("VoltWorks Visitor Mgmt: External request flagged for user " + gs.getUserName());
  }
})(current, previous);
]]></script>
