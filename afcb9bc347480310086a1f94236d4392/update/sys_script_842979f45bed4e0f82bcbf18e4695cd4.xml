        <condition/>
        <description>Prevents saving a visit request when Scheduled End is before or equal to Scheduled Start.</description>
        <execute_function>false</execute_function>
        <filter_condition/>
        <is_rest>false</is_rest>
        <message/>
        <name>Validate Schedule Dates</name>
        <order>25</order>
        <priority>100</priority>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[
(function executeRule(current, previous) {
  var startStr = current.getValue('scheduled_start');
  var endStr = current.getValue('scheduled_end');

  if (!startStr || !endStr) {
    return;
  }

  var start = new GlideDateTime(startStr);
  var end = new GlideDateTime(endStr);

  if (end.compareTo(start) <= 0) {
    gs.addErrorMessage(
      'Scheduled End must be after Scheduled Start. ' +
      'Please correct the dates before saving.'
    );
    current.setAbortAction(true);
  }
})(current, previous);
]]></script>
