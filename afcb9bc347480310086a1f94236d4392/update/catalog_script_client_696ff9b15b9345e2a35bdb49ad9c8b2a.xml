        <name>Plant Visit - Validate Visitor Count</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onSubmit() {
  var visitors = g_form.getValue("expected_visitors");
  var visitorCount = parseInt(visitors, 10);

  g_form.hideFieldMsg("expected_visitors", true);

  if (!visitors || isNaN(visitorCount) || visitorCount < 1) {
    g_form.showFieldMsg(
      "expected_visitors",
      "Please enter a valid number of visitors (minimum 1).",
      "error",
      true
    );
    return false;
  }

  return true;
}
]]></script>
