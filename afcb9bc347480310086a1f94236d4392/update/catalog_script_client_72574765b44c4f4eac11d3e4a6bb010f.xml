        <name>Plant Visit - Validate Schedule Dates</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
  if (isLoading) return;

  var startVal = g_form.getValue("scheduled_start");
  var endVal = g_form.getValue("scheduled_end");

  g_form.hideFieldMsg("scheduled_end", true);

  if (!startVal || !endVal) return;

  var startDate = new Date(startVal);
  var endDate = new Date(endVal);

  if (endDate <= startDate) {
    g_form.showFieldMsg(
      "scheduled_end",
      "Scheduled End must be after Scheduled Start.",
      "error",
      false
    );
    g_form.clearValue("scheduled_end");
  }
}
]]></script>
